# Example environment overrides for MMS backend
# Copy to backend/.env if needed
#
# SQL Developer "MISO 5.0" connection: SYSTEM@//localhost:1521/FREEPDB1
# MMS_* tables in this environment are owned by SYSTEM.

ORACLE_USER=SYSTEM
ORACLE_PASSWORD=oracle
ORACLE_DSN=localhost:1521/FREEPDB1
ORACLE_SCHEMA=SYSTEM
DEBUG=true
